/* ============================================================
   COMPOSANTS — chaque bloc reprend une composition d'edgecomply.com
   et la rend avec les tokens Cleo. Aucune couleur ni police etrangere.
   ============================================================ */

/* ── Bandeau d'annonce (leur bandeau lavande, pleine largeur) ── */
.bandeau{background:var(--accent); color:var(--cleo-ink); font-size:0.8125rem; font-weight:500}
.bandeau .conteneur{display:flex; align-items:center; justify-content:center; gap:8px; padding-top:9px; padding-bottom:9px}
.bandeau b{font-weight:700}
.bandeau .fleche{transition:transform var(--duration-normal,250ms) var(--ease-out)}
.bandeau a:hover .fleche{transform:translateX(3px)}

/* ── Navigation (structure : logo · menus · CTA a droite) ── */
.nav{background:var(--ink-deep); color:var(--text-on-dark); position:relative; z-index:50}
.nav .conteneur{display:flex; align-items:center; gap:36px; height:64px}
.nav-logo{display:flex; align-items:center; gap:9px; font-weight:700; font-size:1.0625rem; letter-spacing:-0.02em}
.nav-logo .pastille{width:22px; height:22px; border-radius:6px; background:var(--brand-solid); display:grid; place-items:center; font-size:0.6875rem; color:#fff; font-weight:700}
.nav-liens{display:flex; align-items:center; gap:26px; margin-left:8px}
.nav-liens a{font-size:0.875rem; color:var(--text-on-dark-2); display:flex; align-items:center; gap:5px; transition:color 150ms}
.nav-liens a:hover{color:var(--text-on-dark)}
.nav-liens .chev{width:9px; height:9px; opacity:0.55}
.nav-fin{margin-left:auto; display:flex; align-items:center; gap:16px}
.nav-fin .lien-secondaire{font-size:0.875rem; color:var(--text-on-dark-2)}

/* ── Boutons ── */
.btn{display:inline-flex; align-items:center; gap:10px; border:none; cursor:pointer; font-weight:600;
     font-size:0.9375rem; padding:13px 24px; border-radius:var(--r-pill); transition:all 200ms var(--ease-out)}
.btn-primaire{background:var(--btn-primary-bg); color:var(--btn-primary-text)}
.btn-primaire:hover{background:var(--btn-primary-hover-bg); transform:translateY(-1px)}
.btn-marque{background:var(--brand-solid); color:#fff; box-shadow:var(--shadow-blue)}
.btn-marque:hover{background:var(--brand-hover); transform:translateY(-1px)}
.btn-clair{background:#fff; color:var(--cleo-ink)}
.btn-clair:hover{background:var(--bg-card-hover)}
.btn-contour{background:transparent; border:1px solid var(--border-default); color:var(--text-primary)}
.sur-sombre .btn-contour{border-color:rgba(255,255,255,0.24); color:var(--text-on-dark)}
.btn-sm{padding:9px 18px; font-size:0.875rem}
/* Pastille flechee : la signature de bouton retenue le 31/07 (reference Legora) */
.btn .rond{width:26px; height:26px; border-radius:50%; background:rgba(255,255,255,0.18); display:grid; place-items:center; flex:none}
.btn-clair .rond,.btn-contour .rond{background:var(--brand-muted)}

/* ── Pilules et etiquettes ── */
.pilule{display:inline-flex; align-items:center; gap:7px; padding:6px 14px; border-radius:var(--r-pill);
        font-size:0.8125rem; font-weight:500; background:var(--brand-muted); color:var(--brand-text)}
.pilule-lavande{background:var(--accent-muted); color:#6B4E96}
.pilule-contour{background:transparent; border:1px solid var(--border-default); color:var(--text-secondary)}
.sur-sombre .pilule-contour{border-color:rgba(255,255,255,0.20); color:var(--text-on-dark-2)}
.pilule-dispo{display:inline-flex; align-items:center; gap:9px; font-size:0.875rem; color:var(--text-on-dark-2)}
.pilule-dispo .point{width:8px; height:8px; border-radius:50%; background:#6EE7A8; box-shadow:0 0 0 4px rgba(110,231,168,0.18)}
.pilule-dispo .sep{width:1px; height:14px; background:rgba(255,255,255,0.22)}
.etiquette{display:inline-block; padding:5px 12px; border-radius:var(--r-sm); font-size:0.8125rem;
           font-weight:600; background:var(--accent-light); color:#4A2E75}

/* ── Liste a puces cochees (leur motif le plus repete) ── */
.coches{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:13px}
.coches li{display:flex; gap:12px; align-items:flex-start; font-size:0.9375rem; line-height:1.5; color:var(--text-secondary)}
.sur-sombre .coches li{color:var(--text-on-dark-2)}
.coches .coche{flex:none; width:20px; height:20px; border-radius:50%; background:var(--brand-solid);
               display:grid; place-items:center; margin-top:1px}
.coches .coche svg{width:11px; height:11px}
.coches-encre .coche{background:var(--cleo-ink)}

/* ── Cartes ── */
.carte{background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:var(--r-lg); box-shadow:var(--shadow-sm)}
.carte-tiede{background:var(--bg-card-warm); border:1px solid var(--border-subtle); border-radius:var(--r-lg)}
.carte-sombre{background:var(--ink-card); border:1px solid rgba(255,255,255,0.07); border-radius:var(--r-lg); color:var(--text-on-dark)}
.carte-encre{background:linear-gradient(135deg,var(--ink-deep-2) 0%,var(--ink-deep) 100%);
             border:1px solid rgba(255,255,255,0.07); border-radius:var(--r-lg); color:var(--text-on-dark)}
.carte-lavande{background:var(--accent-light); border-radius:var(--r-lg); color:var(--cleo-ink)}
.p32{padding:32px} .p40{padding:40px} .p48{padding:48px}

/* ── Grilles ── */
.g2{display:grid; grid-template-columns:1fr 1fr; gap:24px}
.g3{display:grid; grid-template-columns:repeat(3,1fr); gap:24px}
.g4{display:grid; grid-template-columns:repeat(4,1fr); gap:20px}
.duo{display:grid; grid-template-columns:1.05fr 1fr; gap:64px; align-items:center}
.duo-inverse{grid-template-columns:1fr 1.05fr}
.entete-section{display:flex; flex-direction:column; gap:14px; margin-bottom:56px}

/* ── Bande de logos clients ── */
.bande-logos{display:flex; align-items:center; justify-content:center; flex-wrap:wrap}
.bande-logos .cellule{padding:22px 34px; border-left:1px solid rgba(255,255,255,0.08); display:grid; place-items:center; min-width:150px}
.bande-logos .cellule:last-child{border-right:1px solid rgba(255,255,255,0.08)}
.bande-logos img{height:26px; width:auto; opacity:0.78; filter:brightness(0) invert(1)}

/* ── Mise en scene produit : photo chaude + interface posee dessus (geste Legora) ── */
.scene{position:relative; border-radius:var(--r-lg); overflow:hidden; box-shadow:var(--shadow-xl)}
.scene img.fond{width:100%; height:100%; object-fit:cover; display:block}
.flottant{position:absolute; background:#fff; border-radius:var(--r-md); box-shadow:var(--shadow-lg); padding:12px 16px}
/* Pilule de reglement flottante : drapeau · nom · statut */
.regle-flottante{display:flex; align-items:center; gap:11px; background:#fff; border-radius:var(--r-pill);
                 padding:9px 12px 9px 10px; box-shadow:var(--shadow-lg); font-size:0.875rem; font-weight:600; color:var(--cleo-ink)}
.regle-flottante .drapeau{width:26px; height:26px; border-radius:50%; display:grid; place-items:center; font-size:0.9rem; background:var(--bg-card-warm); flex:none}
.regle-flottante .statut{width:20px; height:20px; border-radius:50%; display:grid; place-items:center; flex:none; margin-left:auto}
.statut-ok{background:var(--brand-solid)} .statut-vide{background:rgba(0,0,0,0.10)}

/* ── Fiche produit maquette (l'ecran reel de l'app, en reduction) ── */
.fiche{background:#fff; border-radius:var(--r-md); box-shadow:var(--shadow-lg); overflow:hidden; font-size:0.8125rem}
.fiche-tete{display:flex; gap:12px; align-items:center; padding:14px}
.fiche-vignette{width:46px; height:46px; border-radius:var(--r-sm); background:var(--bg-card-warm); object-fit:cover; flex:none}
.fiche-nom{font-weight:600; color:var(--cleo-ink); font-size:0.875rem}
.fiche-ref{color:var(--text-muted); font-size:0.75rem}
.jauge{height:6px; border-radius:var(--r-pill); background:rgba(0,0,0,0.08); overflow:hidden; flex:1}
.jauge span{display:block; height:100%; background:var(--brand-solid); border-radius:var(--r-pill)}
.fiche-ligne{display:flex; align-items:center; justify-content:space-between; gap:10px; padding:11px 14px; border-top:1px solid var(--border-subtle)}
.fiche-entete-pays{display:flex; align-items:center; gap:8px; padding:11px 14px; font-weight:600; color:var(--cleo-ink); border-top:1px solid var(--border-subtle); background:var(--bg-card-hover)}
.marqueur{font-size:0.75rem; font-weight:600; padding:4px 10px; border-radius:var(--r-pill)}
.m-couvert{background:var(--brand-muted); color:var(--brand-text)}
.m-attente{background:var(--accent-muted); color:#6B4E96}
.m-manquant{background:rgba(0,0,0,0.06); color:var(--text-muted)}

/* ── Cartes chiffres en escalier (leur bloc « numbers speak ») ── */
.escalier{display:grid; grid-template-columns:repeat(3,1fr); gap:24px; align-items:start}
.escalier > *:nth-child(2){margin-top:44px} .escalier > *:nth-child(3){margin-top:88px}
.chiffre{font-size:clamp(2.5rem,2rem + 2vw,3.5rem); font-weight:700; letter-spacing:-0.04em; line-height:1}

/* ── Tableau comparatif ── */
.comparatif{width:100%; border-collapse:separate; border-spacing:0 10px}
.comparatif th{font-weight:500; font-size:0.9375rem; color:var(--text-on-dark-2); padding:0 14px 14px; text-align:center; vertical-align:bottom}
.comparatif td{padding:20px 14px; text-align:center; vertical-align:middle; background:transparent}
.comparatif td:first-child{text-align:left; width:36%}
.comparatif .nous td{background:var(--ink-card)}
.comparatif .nous td:first-child{border-radius:var(--r-md) 0 0 var(--r-md)}
.comparatif .nous td:last-child{border-radius:0 var(--r-md) var(--r-md) 0}
.comparatif .nous{outline:1px solid rgba(107,138,255,0.45)}
.ligne-nom{display:flex; align-items:center; gap:14px}
.ligne-icone{width:44px; height:44px; border-radius:var(--r-sm); background:rgba(255,255,255,0.06);
             border:1px solid rgba(255,255,255,0.10); display:grid; place-items:center; flex:none}
.oui{width:26px; height:26px; border-radius:50%; background:var(--brand-solid); display:inline-grid; place-items:center}
.oui-doux{width:26px; height:26px; border-radius:50%; background:rgba(107,138,255,0.16); display:inline-grid; place-items:center}
.non{opacity:0.34; font-size:1.05rem}

/* ── FAQ ── */
.faq{border-top:1px solid var(--border-subtle)}
.sur-sombre .faq{border-color:rgba(255,255,255,0.10)}
.faq details{border-bottom:1px solid var(--border-subtle)}
.sur-sombre .faq details{border-color:rgba(255,255,255,0.10)}
.faq summary{list-style:none; cursor:pointer; padding:22px 4px; display:flex; align-items:center;
             justify-content:space-between; gap:20px; font-size:1rem; font-weight:500}
.faq summary::-webkit-details-marker{display:none}
.faq summary .chev{transition:transform 220ms var(--ease-out); opacity:0.5; flex:none}
.faq details[open] summary .chev{transform:rotate(180deg)}
.faq .reponse{padding:0 4px 24px; max-width:820px; font-size:0.9375rem; line-height:1.65; color:var(--text-secondary)}
.sur-sombre .faq .reponse{color:var(--text-on-dark-2)}

/* ── Temoignage ── */
.temoignage{display:grid; grid-template-columns:340px 1fr; gap:64px; align-items:center}
.temoignage .portrait{border-radius:var(--r-lg); overflow:hidden; box-shadow:var(--shadow-lg)}
.citation{font-size:clamp(1.125rem,1rem + 0.6vw,1.375rem); line-height:1.5; font-weight:500; letter-spacing:-0.012em}
.auteur{display:flex; align-items:center; gap:12px; margin-top:24px}
.auteur img{width:44px; height:44px; border-radius:50%; object-fit:cover}

/* ── CTA final ── */
.cta-final{display:grid; grid-template-columns:200px 1fr; gap:40px; align-items:center}
.cta-final .portrait{width:200px; height:200px; border-radius:var(--r-md); object-fit:cover}

/* ── Pied de page ── */
.pied{background:var(--ink-deep); color:var(--text-on-dark); padding-top:88px; padding-bottom:44px}
.pied-colonnes{display:grid; grid-template-columns:repeat(5,1fr); gap:32px; padding-bottom:56px}
.pied h4{font-size:0.875rem; font-weight:600; margin-bottom:18px; color:var(--text-on-dark)}
.pied ul{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:11px}
.pied ul a{font-size:0.875rem; color:var(--text-on-dark-2); transition:color 150ms}
.pied ul a:hover{color:var(--text-on-dark)}
.pied-regs{display:grid; grid-template-columns:repeat(3,1fr); gap:32px; padding:44px 0;
           border-top:1px solid rgba(255,255,255,0.09)}
.pied-regs .paire{display:grid; grid-template-columns:1fr 1fr; gap:24px}
.pied-bas{border-top:1px solid rgba(255,255,255,0.09); padding-top:28px; display:flex; gap:28px; flex-wrap:wrap;
          font-size:0.8125rem; color:var(--text-on-dark-3)}
.infolettre{background:var(--accent-light); color:var(--cleo-ink); border-radius:var(--r-md); padding:26px; max-width:300px}
.infolettre input{width:100%; padding:10px 13px; border-radius:var(--r-sm); border:1px solid rgba(0,0,0,0.10);
                  background:#fff; font-size:0.875rem; margin-bottom:9px; font-family:inherit}
.infolettre button{width:100%; padding:11px; border-radius:var(--r-sm); border:none; background:var(--cleo-ink);
                   color:#fff; font-weight:600; font-size:0.875rem; cursor:pointer}

/* ── Formulaire lateral des pages industrie / marche ── */
.form-carte{border-radius:var(--r-lg); padding:32px}
.form-carte label{display:block; font-size:0.8125rem; font-weight:500; margin-bottom:7px; color:var(--text-on-dark-2)}
.form-carte input{width:100%; padding:11px 14px; border-radius:var(--r-sm); border:1px solid rgba(255,255,255,0.12);
                  background:#fff; font-size:0.875rem; font-family:inherit; margin-bottom:16px; color:var(--cleo-ink)}
.form-carte input::placeholder{color:var(--text-muted)}
.form-carte .paire{display:grid; grid-template-columns:1fr 1fr; gap:14px}
.avatars{display:flex}
.avatars img{width:40px; height:40px; border-radius:50%; border:2px solid var(--ink-card); object-fit:cover; margin-left:-12px}
.avatars img:first-child{margin-left:0}

/* ── Fiche laterale du cas client ── */
.fiche-laterale{position:sticky; top:24px; align-self:start}
.fiche-laterale .bloc{margin-bottom:26px}
.fiche-laterale .cle{font-size:0.8125rem; color:var(--text-on-dark-3); margin-bottom:6px}
.fiche-laterale .valeur{font-size:0.9375rem; color:var(--text-on-dark); line-height:1.55}

/* ── Recit long ── */
.recit p{font-size:0.9375rem; line-height:1.72; color:var(--text-on-dark-2); margin:0 0 18px}
.recit ul{margin:0 0 18px; padding-left:20px}
.recit li{font-size:0.9375rem; line-height:1.72; color:var(--text-on-dark-2); margin-bottom:10px}
.recit b{color:var(--text-on-dark)}

/* ── Barre de navigation entre les maquettes (hors maquette) ── */
.barre-maquettes{position:fixed; bottom:20px; left:50%; transform:translateX(-50%); z-index:200;
  background:rgba(11,11,31,0.92); backdrop-filter:saturate(180%) blur(20px); border:1px solid rgba(255,255,255,0.12);
  border-radius:var(--r-pill); padding:7px 10px; display:flex; gap:4px; box-shadow:0 12px 40px rgba(0,0,0,0.30)}
.barre-maquettes a{font-size:0.8125rem; color:rgba(255,255,255,0.62); padding:7px 14px; border-radius:var(--r-pill); font-weight:500}
.barre-maquettes a:hover{color:#fff; background:rgba(255,255,255,0.08)}
.barre-maquettes a.actif{color:#fff; background:var(--brand-solid)}

/* ── Adaptation ecran etroit : leurs maquettes n'en ont aucune, on pose le garde-fou ── */
@media (max-width:1024px){
  :root{--gouttiere:28px}
  .duo,.duo-inverse,.temoignage,.cta-final{grid-template-columns:1fr; gap:36px}
  .g3,.g4,.escalier,.pied-colonnes,.pied-regs{grid-template-columns:1fr 1fr}
  .escalier > *{margin-top:0 !important}
  .section{padding:72px 0}
  .cta-final .portrait{width:140px; height:140px}
  .nav-liens{display:none}
}
@media (max-width:640px){
  .g2,.g3,.g4,.escalier,.pied-colonnes,.pied-regs,.form-carte .paire{grid-template-columns:1fr}
  .bande-logos .cellule{padding:16px 20px; min-width:120px}
}

/* ── Bascule de couleur PORTEE PAR LA CARTE, pas par la section ──
   Vecu le 26/08 : une carte encre posee dans une section claire gardait
   le texte noir des listes et des chapos, illisible et invisible au grep.
   Les cartes sombres reglent donc leur propre encre. */
.carte-encre,.carte-sombre{color:var(--text-on-dark)}
.carte-encre .t-lead,.carte-encre .t-body,.carte-encre .t-sm,
.carte-sombre .t-lead,.carte-sombre .t-body,.carte-sombre .t-sm{color:var(--text-on-dark-2)}
.carte-encre .t-micro,.carte-sombre .t-micro{color:var(--text-on-dark-3)}
.carte-encre .coches li,.carte-sombre .coches li{color:var(--text-on-dark-2)}
.carte-encre .attenue,.carte-sombre .attenue{color:var(--text-on-dark-3)}
.carte-encre .surtitre,.carte-sombre .surtitre{color:var(--brand-on-dark)}
.carte-encre .pilule-contour,.carte-sombre .pilule-contour{border-color:rgba(255,255,255,0.20);color:var(--text-on-dark-2)}
/* La carte lavande est claire : elle reprend l'encre sombre meme en section sombre */
.carte-lavande,.carte-lavande .t-sm,.carte-lavande .t-micro{color:var(--cleo-ink)}

/* ── Bande de logos : hauteurs normalisees ──
   Les logos clients ont des proportions tres inegales (Decathlon large,
   Electrolux carre). Une hauteur unique les rend illisibles : on borne
   la boite et on laisse chaque logo s'inscrire dedans. */
.bande-logos .cellule{height:82px}
.bande-logos img{height:auto; width:auto; object-fit:contain}
/* Hauteurs par logo, reprises de cleo-landing/src/components/landing/LogoWall.tsx :
   les logos composes (avec baseline) ont besoin de plus de pixels pour que la
   partie lisible rende a taille visuellement egale aux mots-symboles. */
.bande-logos img[alt="Decathlon"]{height:26px}
.bande-logos img[alt="L'Occitane"]{height:23px}
.bande-logos img[alt="Balzac Paris"]{height:23px}
.bande-logos img[alt="Mercedes-Benz"]{height:30px}
.bande-logos img[alt="Electrolux Professional"]{height:40px}
.bande-logos img[alt="SNCF Réseau"]{height:36px}

/* ── Barre de navigation entre maquettes : retiree a la capture ── */
.capture .barre-maquettes{display:none}

/* ── Fond lavande pâle : l'accent Cleo à 8 % aplati sur le frost.
      Sert la bascule clair/sombre des pages secteur et marché. ── */
.fond-lavande{background:#F4F1F8}
.fond-lavande .t-lead,.fond-lavande .t-body{color:var(--text-secondary)}

/* ── Sceau de réglementation (leur badge festonné) ── */
.sceau{position:relative;width:132px;height:132px;margin:0 auto 20px;display:grid;place-items:center}
.sceau svg{position:absolute;inset:0;width:100%;height:100%}
.sceau .dedans{position:relative;text-align:center;line-height:1.1}
.sceau .nom{font-size:1.0625rem;font-weight:700;letter-spacing:-0.02em;color:#4A2E75}
.sceau .sous{font-size:0.5625rem;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#6B4E96;margin-top:4px}

/* ── Bloc alterné texte / image ── */
.alterne{display:grid;grid-template-columns:1fr 1.06fr;gap:72px;align-items:center;padding:44px 0}
.alterne.inverse{grid-template-columns:1.06fr 1fr}
.alterne.inverse .texte{order:2}
@media (max-width:1024px){
  .alterne,.alterne.inverse{grid-template-columns:1fr;gap:32px;padding:28px 0}
  .alterne.inverse .texte{order:0}
}

/* ── Corps du cas client : fiche latérale + récit ── */
.cas-corps{display:grid;grid-template-columns:260px 1fr;gap:80px;align-items:start}

/* ── Pile des règles flottantes du hero ── */
.pile-regles{position:absolute;right:-40px;top:44px;display:flex;flex-direction:column;gap:13px;width:290px}

/* ── Garde-fou téléphone : les deux blocs qui débordaient au relevé du 26/08 ──
      Une composition relevée sur un site sans media query se casse toujours
      là où quelque chose est posé en absolu ou sur une colonne fixe. */
@media (max-width:1024px){
  .cas-corps{grid-template-columns:1fr;gap:40px}
  .fiche-laterale{position:static}
  /* Les règles quittent la photo et reprennent le flux, sous elle. */
  .pile-regles{position:static;width:auto;margin-top:16px;display:grid;
               grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
  .pile-regles > *{transform:none !important;box-shadow:var(--shadow-md) !important}
}

/* ── Le tableau comparatif ne se replie pas : il défile dans sa propre boîte,
      pour que la page elle-même ne défile jamais horizontalement. ── */
.table-defilante{overflow-x:auto;-webkit-overflow-scrolling:touch}
.table-defilante .comparatif{min-width:600px}

/* ── Le pied de page porte sa propre encre ──
      Comme les cartes sombres : sans la classe .sur-sombre sur un ancêtre,
      .t-sm et .t-micro restaient en noir et le bloc identité disparaissait. */
.pied .t-sm{color:var(--text-on-dark-2)}
.pied .t-micro{color:var(--text-on-dark-3)}
.pied .pilule-contour{border-color:rgba(255,255,255,0.20);color:var(--text-on-dark-2)}
.pied .infolettre,.pied .infolettre *{color:var(--cleo-ink)}
.pied .infolettre button{color:#fff}
